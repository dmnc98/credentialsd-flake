From 41d83bff5e44dc976479e37bace5e29261af9265
Subject: [PATCH] registry: Reject the insert promise when propagating an error

Otherwise the insert operation is blocking XdpAppInfoRegistry operations
for this peer forever.

Backported from flatpak/xdg-desktop-portal main; pr-2036.patch predates it.

--- a/src/registry.c
+++ b/src/registry.c
@@ -127,6 +127,10 @@ handle_register (XdpDbusHostRegistry   *object,
     {
       g_debug ("Can't create registered app for %s: %s",
                sender, error->message);
+      dex_promise_reject (app_info_promise,
+                          g_error_new_literal (G_IO_ERROR,
+                                               G_IO_ERROR_PERMISSION_DENIED,
+                                               "Failed to create app info"));
       g_dbus_method_invocation_return_error (invocation,
                                              XDG_DESKTOP_PORTAL_ERROR,
                                              XDG_DESKTOP_PORTAL_ERROR_FAILED,
