From 6b0e9bad83a90ab31cf754cfe3271cd78a021a06 Mon Sep 17 00:00:00 2001
From: Sebastian Wick <sebastian.wick@redhat.com>
Date: Wed, 18 Mar 2026 22:05:10 +0100
Subject: [PATCH 1/8] tests: Enabled the slow ASAN stack unwinder

The fast one is not working well for us anymore and gives us false
positives with useless backtraces.
The unwinder is ~10x more slow, but given that xdp doesn't actually
execute a lot of code, this seems fine.
---
 tests/conftest.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

Index: xdg-desktop-portal-1.22.1/tests/conftest.py
===================================================================
--- xdg-desktop-portal-1.22.1.orig/tests/conftest.py
+++ xdg-desktop-portal-1.22.1/tests/conftest.py
@@ -502,7 +502,7 @@ def xdp_env(
     asan_suppression = test_dir() / "asan.suppression"
     if not asan_suppression.exists():
         raise FileNotFoundError(f"{asan_suppression} does not exist")
-    env["LSAN_OPTIONS"] = f"suppressions={asan_suppression}"
+    env["LSAN_OPTIONS"] = f"suppressions={asan_suppression},fast_unwind_on_malloc=0"
 
     for key, val in xdp_overwrite_env.items():
         env[key] = val
